#if (subject contains "Return") then save "/users/habs/Mail/bad"

if (subject contains "Failed") then delete
#if (subject contains "Failed") then save "/users/habs/Mail/bad"

#if (subject contains "uucp") then delete
#if (subject contains "uucp") then save "/users/habs/Mail/bad"

#if (sender contains "uucp") then delete

#if (from contains "uucp") then delete

#if (to contains "Extropos") then save "/users/habs/Mail/Pos"

