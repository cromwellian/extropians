{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 scripts/fetch_data.py && cd web && npm install && npm run build",
  "functions": {
    "app.py": {
      "memory": 2048,
      "maxDuration": 300,
      "excludeFiles": "{archives/**,digests/**,rag/.venv/**,web/node_modules/**,web/src/**,**/__pycache__/**,**/*.pyc}"
    }
  }
}
